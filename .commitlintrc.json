{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "ci",
        "revert"
      ]
    ],
    "scope-enum": [2, "always", ["gagent", "gbrain", "gstack", "gorchestrator", "gmirror", "gtom", "glearn", "dyad", "mcp", "cli", "persistence"]],
    "subject-case": [0]
  }
}
