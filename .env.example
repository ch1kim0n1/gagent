# GAgent Configuration

# LLM API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tool Endpoints
GBRAIN_ENDPOINT=http://localhost:3000
GSTACK_ENDPOINT=http://localhost:3001
GORCHESTRATOR_ENDPOINT=http://localhost:3002
GMIRROR_ENDPOINT=http://localhost:3003
GTOM_ENDPOINT=http://localhost:3004
GLEARN_ENDPOINT=http://localhost:3005

# Tool Status
GBRAIN_ENABLED=false
GSTACK_ENABLED=false
GORCHESTRATOR_ENABLED=false
GMIRROR_ENABLED=false
GTOM_ENABLED=false
GLEARN_ENABLED=false

# Integration Settings
EVENT_BUS=gbrain
SHARED_MEMORY=true
CROSS_TOOL_SYNC=true

# Pipeline Settings
DEFAULT_PARALLEL=3
MAX_PARALLEL=10
VERIFICATION_THRESHOLD=0.7
COGNITIVE_CHECK_THRESHOLD=0.6

# Logging
LOG_LEVEL=info
